policy_module(aurora_firstboot, 1.1.0)

# Aurora's first-boot programs live under /usr/lib/aurora, which the base
# policy labels lib_t. systemd runs a lib_t program in its own init_t domain,
# where account and disk tools such as chpasswd are denied. Labelling these
# programs as ordinary executables lets systemd start them in
# unconfined_service_t, like any other administrator-installed service.
gen_require(`
	type bin_t;
	type xdm_t;
	type unconfined_service_t;
')

# The owner's password also becomes the disk password. PAM runs
# aurora-password-hook from the greeters (xdm_t), for the owner's first
# password sign-in and to send the owner's automatic login to the greeter
# meanwhile. Only this one program enters the unconfined service domain from
# them, to hand the password to aurora-disk-rekey.service.
type aurora_password_hook_exec_t;
corecmd_executable_file(aurora_password_hook_exec_t)
domain_entry_file(unconfined_service_t, aurora_password_hook_exec_t)
domtrans_pattern(xdm_t, aurora_password_hook_exec_t, unconfined_service_t)
