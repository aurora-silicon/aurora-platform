[Unit]
Description=Power profile legs beyond the CPU budget, and Low Power Mode scheduling (Apple silicon)
Documentation=https://github.com/aurora-silicon/aurora-platform/blob/main/power/README.md
ConditionPathExists=/sys/firmware/devicetree/base/cpus
After=tuned-ppd.service power-profiles-daemon.service

[Service]
Type=simple
ExecStart=/usr/libexec/aurora/aurora-power-modes
Restart=on-failure
RestartSec=5
RuntimeDirectory=aurora-power-modes
# Keeps baselines.json across Restart=on-failure, so a restarted daemon restores
# the values found at boot, not the ones its last profile wrote.
RuntimeDirectoryPreserve=restart
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
