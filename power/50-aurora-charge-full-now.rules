// Let the active local user start and cancel the one-shot charge to full
// without a password.  This mirrors UPower's own action for the charge limit,
// org.freedesktop.UPower.enable-charging-limit (allow_active = yes): the
// service only lifts that limit through UPower and always puts it back.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "aurora-charge-full-now.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
