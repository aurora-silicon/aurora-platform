[Unit]
Description=Plan a charge to full by %I
Documentation=https://github.com/aurora-silicon/aurora-platform/blob/main/power/README.md
Wants=upower.service
After=upower.service

[Service]
Type=oneshot
# Computes the start time and arms the transient aurora-charge-full-now-schedule.timer,
# or starts aurora-charge-full-now.service at once.  It never touches the limit.
ExecStart=/usr/bin/aurora-charge-full-now arm %i
RuntimeDirectory=aurora-charge-full-now
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
