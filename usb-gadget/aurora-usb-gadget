#!/bin/bash
# SPDX-License-Identifier: MIT
# USB device mode: when a USB host (another computer) is plugged into a
# USB-C port that the kernel switches to device mode, this Mac shows up on
# that host as a network adapter (CDC-NCM), a serial port (CDC-ACM) and,
# if configured, a disk (mass storage). See usb-gadget/README.md.
#
#   aurora-usb-gadget up [UDC]        build the gadget and bind it to UDC
#                                     (default: the first one). Idempotent.
#   aurora-usb-gadget down [UDC]      without UDC: unbind and remove the
#                                     gadget. With UDC: unbind from that
#                                     controller only, and move to another
#                                     one if there is one.
#   aurora-usb-gadget status          controller, link state, speed,
#                                     interface and addresses.
#   aurora-usb-gadget console enable|disable
#                                     a login prompt on the serial port.
#
# No configfs, no USB device controller, or ENABLED=no: nothing happens and
# the exit status is 0.
set -uo pipefail

CONFIGFS=${AURORA_GADGET_CONFIGFS:-/sys/kernel/config}
SYSFS=${AURORA_GADGET_SYSFS:-/sys}
RUN=${AURORA_GADGET_RUN:-/run}
CONF=${AURORA_GADGET_CONF:-/etc/aurora/usb-gadget.conf}
MACHINE_ID=${AURORA_GADGET_MACHINE_ID:-/etc/machine-id}
WAIT=${AURORA_GADGET_WAIT:-5}   # seconds to wait for the network interface after binding

NAME=aurora
G=$CONFIGFS/usb_gadget/$NAME
C=$G/configs/c.1
IFNAME_TEMPLATE=usbaurora%d
IFNAME_GLOB='usbaurora*'
NM_ID="Aurora USB gadget"
NM_FILE=$RUN/NetworkManager/system-connections/aurora-usb-gadget.nmconnection
NETWORKD_FILE=$RUN/systemd/network/70-aurora-usb-gadget.network

# Linux Foundation "Multifunction Composite Gadget": the ID the Linux
# kernel's own composite gadgets (g_multi) use.
VENDOR_ID=0x1d6b
PRODUCT_ID=0x0104

log() { echo "aurora-usb-gadget: $*"; }

# A test tree is a plain directory, where configfs directories can only be
# removed with rm -r. Never do that on the real configfs.
fake() { [[ $CONFIGFS != /sys/kernel/config ]]; }

rmnode() {
  [[ -e $1 || -L $1 ]] || return 0
  if [[ -L $1 ]]; then
    rm -f "$1"
  elif fake; then
    rm -rf "$1"
  else
    rmdir "$1" 2>/dev/null
  fi
}

put() {   # put <value> <attribute file>
  { printf '%s\n' "$1" > "$2"; } 2>/dev/null || log "cannot write $1 to ${2#"$G"/}"
}

get() {   # the first line of a file; fails quietly if it cannot be read
  local v=
  [[ -r $1 ]] || return 1
  { read -r v < "$1" || [[ -n $v ]]; } 2>/dev/null && printf '%s' "$v"
}

# --- configuration ------------------------------------------------------

declare -A CFG=([ENABLED]=yes [FUNCTIONS]="ncm acm" [IPV4]=link-local [CONSOLE]=no
                [STORAGE_IMAGE]="" [STORAGE_READONLY]=yes [STORAGE_CDROM]=no)

load_conf() {
  local line key val
  [[ -r $CONF ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    [[ $line == *=* ]] || continue
    key=${line%%=*}
    val=${line#*=}
    key=${key//[[:space:]]/}
    val=${val#"${val%%[![:space:]]*}"}
    val=${val%"${val##*[![:space:]]}"}
    val=${val#[\"\']}
    val=${val%[\"\']}
    [[ -v CFG[$key] ]] && CFG[$key]=$val
  done < "$CONF"
}

truthy() { [[ ${1,,} == @(yes|y|true|1|on) ]]; }

has_function() { [[ " ${CFG[FUNCTIONS]} " == *" $1 "* ]]; }

# --- identity -----------------------------------------------------------

# Stable per machine, not random per boot: hashed from /etc/machine-id with
# a purpose label, so the machine ID itself never leaves the machine.
digest() {
  local id
  id=$(tr -d '[:space:]' < "$MACHINE_ID" 2>/dev/null) || return 1
  [[ -n $id ]] || return 1
  printf 'aurora-usb-gadget:%s:%s' "$1" "$id" | sha256sum | cut -c1-32
}

# A locally administered unicast MAC address.
mac() {
  local h first
  h=$(digest "$1") || return 1
  first=$(( (16#${h:0:2} & 0xfe) | 0x02 ))
  printf '%02x:%s:%s:%s:%s:%s\n' "$first" "${h:2:2}" "${h:4:2}" "${h:6:2}" "${h:8:2}" "${h:10:2}"
}

serial() { local h; h=$(digest serial) && printf '%s\n' "${h:0:16}"; }

# --- controllers ----------------------------------------------------------

udcs() {
  local path
  for path in "$SYSFS"/class/udc/*; do
    [[ -e $path ]] && echo "${path##*/}"
  done
}

bound_udc() {   # the controller the gadget is bound to, if it still exists
  local udc
  udc=$(get "$G/UDC")
  [[ -n $udc && -e $SYSFS/class/udc/$udc ]] && echo "$udc"
}

ifname() {
  local n
  n=$(get "$G/functions/ncm.usb0/ifname")
  [[ -n $n && $n != *%* && $n != "(unnamed"* ]] && echo "$n"
}

acm_tty() {
  local n
  [[ -d $G/functions/acm.GS0 ]] || return 1
  n=$(get "$G/functions/acm.GS0/port_num")
  echo "ttyGS${n:-0}"
}

# --- gadget tree ----------------------------------------------------------

# Function attributes are read-only while the function is linked into a
# configuration, so build() unlinks everything, configures, then links.
drop_function() { rmnode "$G/functions/$1"; }

build() {
  local s f m l image lun
  mkdir -p "$G/strings/0x409" "$C/strings/0x409" || return 1
  for l in "$C"/*; do
    [[ -L $l ]] && rm -f "$l"
  done
  put "$VENDOR_ID" "$G/idVendor"
  put "$PRODUCT_ID" "$G/idProduct"
  put 0x0100 "$G/bcdDevice"
  put 0x0200 "$G/bcdUSB"
  # Miscellaneous device class with Interface Association Descriptors, so
  # hosts bind one driver per function.
  put 0xEF "$G/bDeviceClass"
  put 0x02 "$G/bDeviceSubClass"
  put 0x01 "$G/bDeviceProtocol"
  put "Aurora Silicon" "$G/strings/0x409/manufacturer"
  put "Aurora USB Gadget" "$G/strings/0x409/product"
  s=$(serial) && put "$s" "$G/strings/0x409/serialnumber"
  put "Network and serial" "$C/strings/0x409/configuration"
  put 0xc0 "$C/bmAttributes"   # self-powered

  if has_function ncm; then
    f=$G/functions/ncm.usb0
    mkdir -p "$f" || return 1
    m=$(mac host) && put "$m" "$f/host_addr"
    m=$(mac device) && put "$m" "$f/dev_addr"
    # A fixed name prefix keeps the network configuration below off other
    # usb* interfaces (phone tethering on this Mac as a host, for example).
    # The kernel resolves the %d when it registers the interface at the
    # first bind, and keeps the name after that.
    [[ $(get "$f/ifname") == usbaurora* ]] || put "$IFNAME_TEMPLATE" "$f/ifname"
  else
    drop_function ncm.usb0
  fi

  if has_function acm; then
    mkdir -p "$G/functions/acm.GS0" || return 1
  else
    drop_function acm.GS0
  fi

  image=${CFG[STORAGE_IMAGE]}
  if [[ -n $image && -f $image ]]; then
    lun=$G/functions/mass_storage.usb0/lun.0
    mkdir -p "$lun" || return 1
    put "" "$lun/file"
    put "$(truthy "${CFG[STORAGE_READONLY]}" && echo 1 || echo 0)" "$lun/ro"
    put 1 "$lun/removable"
    put "$(truthy "${CFG[STORAGE_CDROM]}" && echo 1 || echo 0)" "$lun/cdrom"
    put "$image" "$lun/file"
  else
    [[ -n $image ]] && log "storage image $image not found; no disk offered"
    drop_function mass_storage.usb0
  fi

  for f in ncm.usb0 acm.GS0 mass_storage.usb0; do
    [[ -d $G/functions/$f ]] && ln -s "$G/functions/$f" "$C/$f"
  done
  return 0
}

teardown() {
  local f
  for f in "$C"/*; do
    [[ -L $f ]] && rm -f "$f"
  done
  rmnode "$C/strings/0x409"
  rmnode "$C"
  for f in "$G"/functions/*; do
    [[ -e $f ]] && rmnode "$f"
  done
  rmnode "$G/strings/0x409"
  rmnode "$G"
}

release_storage() {   # let go of the image file while unbound
  local lun=$G/functions/mass_storage.usb0/lun.0
  [[ -e $lun/file ]] && put "" "$lun/file"
  return 0
}

# --- network ----------------------------------------------------------------

# IPv6 link-local always; IPv4 link-local (169.254/16) by default, as macOS
# does on its side, or "shared": this Mac serves DHCP and NAT to the host.
write_network() {
  local ipv4=${CFG[IPV4]} tmp
  has_function ncm || return 0
  if [[ -d $RUN/NetworkManager ]] && command -v nmcli >/dev/null; then
    local method=link-local
    case $ipv4 in shared) method=shared ;; off|none|disabled) method=disabled ;; esac
    mkdir -p "${NM_FILE%/*}" || return 0
    tmp=$(mktemp "${NM_FILE%/*}/.aurora-usb-gadget.XXXXXX") || return 0
    cat > "$tmp" <<EOF
# Written by aurora-usb-gadget from $CONF; edit that file instead.
[connection]
id=$NM_ID
uuid=7d7f1c2e-5a4b-4e8e-9a6c-61757261750a
type=ethernet
autoconnect=true
autoconnect-priority=50

[match]
interface-name=$IFNAME_GLOB

[ipv4]
method=$method

[ipv6]
method=link-local
EOF
    chmod 600 "$tmp"
    mv -f "$tmp" "$NM_FILE"
    nmcli connection load "$NM_FILE" >/dev/null 2>&1 || nmcli connection reload >/dev/null 2>&1
  elif [[ -d $RUN/systemd/netif ]] && command -v networkctl >/dev/null; then
    mkdir -p "${NETWORKD_FILE%/*}" || return 0
    tmp=$(mktemp "${NETWORKD_FILE%/*}/.aurora-usb-gadget.XXXXXX") || return 0
    {
      echo "# Written by aurora-usb-gadget from $CONF; edit that file instead."
      echo "[Match]"
      echo "Name=$IFNAME_GLOB"
      echo
      echo "[Network]"
      case $ipv4 in
        shared)
          echo "LinkLocalAddressing=ipv6"
          echo "Address=10.42.0.1/24"
          echo "DHCPServer=yes"
          echo "IPMasquerade=ipv4" ;;
        off|none|disabled)
          echo "LinkLocalAddressing=ipv6" ;;
        *)
          echo "LinkLocalAddressing=yes" ;;
      esac
      echo "IPv6AcceptRA=no"
    } > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$NETWORKD_FILE"
    networkctl reload >/dev/null 2>&1
  fi
  return 0
}

remove_network() {
  if [[ -e $NM_FILE ]]; then
    rm -f "$NM_FILE"
    command -v nmcli >/dev/null && nmcli connection reload >/dev/null 2>&1
  fi
  if [[ -e $NETWORKD_FILE ]]; then
    rm -f "$NETWORKD_FILE"
    command -v networkctl >/dev/null && networkctl reload >/dev/null 2>&1
  fi
  return 0
}

# Without NetworkManager or systemd-networkd, bring the link up so the
# kernel at least gives it an IPv6 link-local address.
link_up() {
  local n deadline=$((SECONDS + WAIT))
  has_function ncm || return 0
  until n=$(ifname); do
    (( SECONDS < deadline )) || { log "network interface not registered"; return 0; }
    sleep 0.2
  done
  if [[ ! -e $NM_FILE && ! -e $NETWORKD_FILE ]] && command -v ip >/dev/null; then
    ip link set dev "$n" up 2>/dev/null
  fi
  log "network interface $n"
}

console_sync() {
  local tty
  tty=$(acm_tty) || return 0
  command -v systemctl >/dev/null || return 0
  if truthy "${CFG[CONSOLE]}"; then
    systemctl --no-block start "serial-getty@$tty.service" 2>/dev/null
  else
    systemctl --no-block stop "serial-getty@$tty.service" 2>/dev/null
  fi
  return 0
}

# --- commands -------------------------------------------------------------------

load_modules() {
  local mods=(libcomposite)
  has_function ncm && mods+=(usb_f_ncm)
  has_function acm && mods+=(usb_f_acm)
  [[ -n ${CFG[STORAGE_IMAGE]} ]] && mods+=(usb_f_mass_storage)
  command -v modprobe >/dev/null && modprobe -q -a "${mods[@]}" 2>/dev/null
  return 0
}

cmd_up() {
  local want=${1:-} cur
  truthy "${CFG[ENABLED]}" || { log "disabled in $CONF"; return 0; }
  if [[ -n $want ]]; then
    [[ -e $SYSFS/class/udc/$want ]] || { log "no USB device controller $want"; return 0; }
  else
    want=$(udcs | head -n 1)
    [[ -n $want ]] || { log "no USB device controller (no port in device mode)"; return 0; }
  fi
  [[ -d $CONFIGFS/usb_gadget ]] || load_modules
  [[ -d $CONFIGFS/usb_gadget ]] || { log "no USB gadget configfs"; return 0; }

  cur=$(bound_udc)
  if [[ -n $cur ]]; then
    if [[ $cur == "$want" ]]; then
      log "already bound to $cur"
    else
      log "bound to $cur; $want left free"
    fi
    return 0
  fi
  # Unbound, or bound to a controller that went away: build afresh.
  [[ -n $(get "$G/UDC") ]] && put "" "$G/UDC"
  load_modules
  build || { log "cannot create $G"; return 0; }
  write_network
  if ! printf '%s\n' "$want" > "$G/UDC" 2>/dev/null; then
    log "cannot bind to $want"
    return 0
  fi
  log "bound to $want"
  link_up
  console_sync
}

cmd_down() {
  local udc=${1:-} cur other
  [[ -d $G ]] || return 0
  cur=$(get "$G/UDC")
  if [[ -n $udc ]]; then
    [[ -z $cur || $cur == "$udc" ]] || return 0
    [[ -n $cur ]] && put "" "$G/UDC"
    release_storage
    log "unbound from $udc"
    # A second controller in device mode can take over.
    other=$(udcs | grep -vxF -- "$udc" | head -n 1)
    [[ -n $other ]] && cmd_up "$other"
    return 0
  fi
  [[ -n $cur ]] && put "" "$G/UDC"
  CFG[CONSOLE]=no
  console_sync
  release_storage
  teardown
  remove_network
  log "removed"
}

cmd_status() {
  local udc n m tty
  if [[ ! -d $G ]]; then
    echo "gadget: not set up"
    udc=$(udcs | tr '\n' ' ')
    echo "device controllers: ${udc:-none}"
    return 0
  fi
  udc=$(bound_udc)
  if [[ -n $udc ]]; then
    echo "gadget: bound to $udc"
    echo "state: $(get "$SYSFS/class/udc/$udc/state")"
    echo "speed: $(get "$SYSFS/class/udc/$udc/current_speed")"
  else
    echo "gadget: not bound"
  fi
  echo "usb id: $(get "$G/idVendor"):$(get "$G/idProduct") serial $(get "$G/strings/0x409/serialnumber")"
  if [[ -d $G/functions/ncm.usb0 ]]; then
    n=$(ifname) || n="(not registered)"
    m=$(get "$G/functions/ncm.usb0/dev_addr")
    echo "network: $n, MAC $m, host side MAC $(get "$G/functions/ncm.usb0/host_addr")"
    if [[ -e $SYSFS/class/net/$n ]] && command -v ip >/dev/null; then
      ip -o addr show dev "$n" 2>/dev/null | awk '{print "address: " $4}'
    fi
  fi
  if tty=$(acm_tty); then
    echo "serial: /dev/$tty, login prompt $(truthy "${CFG[CONSOLE]}" && echo enabled || echo disabled)"
  fi
  if [[ -d $G/functions/mass_storage.usb0 ]]; then
    local lun=$G/functions/mass_storage.usb0/lun.0
    echo "disk: $(get "$lun/file") ($( [[ $(get "$lun/ro") == 1 ]] && echo read-only || echo read-write))"
  fi
}

cmd_console() {
  local value tmp dir
  case ${1:-} in
    enable) value=yes ;;
    disable) value=no ;;
    *) usage >&2; return 2 ;;
  esac
  dir=${CONF%/*}
  mkdir -p "$dir" || return 1
  tmp=$(mktemp "$dir/.usb-gadget.conf.XXXXXX") || return 1
  if [[ -f $CONF ]] && grep -q '^[[:space:]]*CONSOLE[[:space:]]*=' "$CONF"; then
    sed "s/^[[:space:]]*CONSOLE[[:space:]]*=.*/CONSOLE=$value/" "$CONF" > "$tmp"
  else
    { [[ -f $CONF ]] && cat "$CONF"; echo "CONSOLE=$value"; } > "$tmp"
  fi
  chmod 644 "$tmp"
  mv -f "$tmp" "$CONF"
  CFG[CONSOLE]=$value
  console_sync
  log "login prompt on the USB serial port: ${1}d"
}

usage() {
  cat <<EOF
usage: aurora-usb-gadget up [UDC] | down [UDC] | status | console enable|disable
Configuration: $CONF
EOF
}

load_conf
case ${1:-} in
  up) cmd_up "${2:-}"; exit 0 ;;
  down) cmd_down "${2:-}"; exit 0 ;;
  status) cmd_status; exit 0 ;;
  console) cmd_console "${2:-}"; exit ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
