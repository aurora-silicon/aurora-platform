#!/bin/bash
# SPDX-License-Identifier: MIT
# First-boot owner setup; macOS owner credentials never enter this interface.
#
# Desktop images: hand over to the desktop's own graphical setup (Plasma
# Setup, GNOME Initial Setup), which creates the owner account. The password
# the person chooses there also becomes the disk password: PAM passes it to
# this script as it is set or first used, and the disk is rekeyed then. Where
# PAM cannot be hooked (a generated, read-only configuration), the disk
# password is asked for on the boot splash instead. Minimal images, and any
# boot with aurora.firstboot=text on the kernel command line, use the text
# wizard on tty1, where one password protects both the account and the disk.
set -euo pipefail
umask 077
state=${AURORA_FIRSTBOOT_STATE:-/var/lib/aurora/firstboot}
boot_dir=${AURORA_BOOT_DIR:-/boot}
console=${AURORA_FIRSTBOOT_TTY:-/dev/tty1}
error_file=/run/aurora-firstboot.error

log() { logger -t aurora-firstboot -- "$*" 2>/dev/null || true; }
# A warning reaches the journal at warning priority and, from the text
# wizard, the console.
warn() {
  logger -p user.warning -t aurora-firstboot -- "$*" 2>/dev/null || true
  printf 'aurora-firstboot: %s\n' "$*" >&2
}

text_requested() { [[ " $(</proc/cmdline) " == *" aurora.firstboot=text "* ]]; }

# A person's account: a regular UID and a login shell (NixOS build users and
# other service accounts in that range use nologin).
owner_exists() {
  getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { found = 1 } END { exit !found }'
}

if [[ ${1:-} != --password-hook && ${1:-} != --rekey && ${1:-} != --sync-initrd-keymap && ! -f $state/pending ]]; then
  # Recovery: the text wizard can be asked for while no owner exists, for
  # example when the desktop's own setup cannot run.
  [[ ${1:-} != --attempt ]] && text_requested && ! owner_exists || exit 0
  install -d -m 0700 "$state"
  touch "$state/pending"
fi

splash_up() { command -v plymouth >/dev/null 2>&1 && timeout 5 plymouth --ping 2>/dev/null; }

# Give the console a bounded chance to come back from the boot splash. A splash
# that does not quit is stopped, so it can never hide this setup indefinitely.
release_splash() {
  local attempt pid=''
  command -v plymouth >/dev/null 2>&1 || return 0
  [[ ! -r /run/plymouth/pid ]] || pid=$(tr -cd '0-9' < /run/plymouth/pid)
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null || pid=$(pgrep -x plymouthd 2>/dev/null | head -n 1 || true)
  if timeout 5 plymouth --ping 2>/dev/null; then
    timeout --kill-after=2 10 plymouth quit 2>/dev/null || log 'plymouth quit did not complete'
  elif [[ -n $pid ]]; then
    log "the boot splash (pid $pid) is not responding"
  fi
  [[ -n $pid ]] || return 0
  for attempt in {1..20}; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.25
  done
  log "stopping the boot splash (pid $pid)"
  kill -TERM "$pid" 2>/dev/null || true
  for attempt in {1..10}; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.2
  done
  kill -KILL "$pid" 2>/dev/null || true
}

# Take tty1 for the prompts once nothing else (the splash) reads from it.
# A splash that was stopped can leave the virtual terminal in graphics mode,
# where text is never drawn; KDSETMODE(KD_TEXT) makes the prompts visible.
show_text_console() {
  [[ $console == /dev/tty[0-9]* && -c $console ]] || return 0
  exec 0<>"$console" 1>&0 2>&0
  stty sane 2>/dev/null || true
  ! command -v kbd_mode >/dev/null || kbd_mode -u 2>/dev/null || true
  python3 - "$console" <<'PY' 2>/dev/null || true
import fcntl, os, sys
fd = os.open(sys.argv[1], os.O_RDWR | os.O_NOCTTY)
fcntl.ioctl(fd, 0x4B3A, 0)  # KDSETMODE, KD_TEXT
os.close(fd)
PY
  # Clear whatever the splash or boot messages left on the console.
  printf '\033[H\033[2J'
  ! command -v chvt >/dev/null || chvt "${console#/dev/tty}" 2>/dev/null || true
}

# systemd status lines and kernel messages share this console with the
# prompts. Mute both while setup owns it; restore them when it finishes.
show_status=''
console_level=''
# Images boot with systemd.show_status=auto: status stays quiet until a job is
# slow, and then systemd prints status lines and "A start job is running for
# Aurora first-boot setup" over the prompts. Turn status output off while
# setup owns the console, whatever it reads now, and afterwards reset it to
# the configured mode (an empty mode).
show_status_call() {
  busctl call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
    SetShowStatus s "$1" >/dev/null 2>&1
}
quiet_console() {
  # ShowStatus reads yes while status is shown, including auto's temporary on.
  show_status=$(systemctl show --property=ShowStatus --value 2>/dev/null || true)
  show_status_call no || kill -s SIGRTMIN+21 1 2>/dev/null || true
  if [[ -w /proc/sys/kernel/printk ]]; then
    read -r console_level _ < /proc/sys/kernel/printk || console_level=''
    printf '1\n' > /proc/sys/kernel/printk 2>/dev/null || console_level=''
  fi
}
restore_console() {
  [[ -z $console_level ]] || printf '%s\n' "$console_level" > /proc/sys/kernel/printk 2>/dev/null || true
  # Without the D-Bus call, the signals can only switch status fully on.
  show_status_call '' || [[ $show_status != yes ]] || kill -s SIGRTMIN+20 1 2>/dev/null || true
  console_level=''
  show_status=''
}

# Fedora enforces SELinux: give each file setup creates its policy label at
# once, so an interrupted setup never leaves a mislabelled system file behind.
label() {
  command -v restorecon >/dev/null 2>&1 || return 0
  command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled || return 0
  restorecon -F "$@"
}

# Say something where the person can see it: the splash while it is up,
# otherwise the console.
splash_message=''
say() {
  if splash_up; then
    [[ -z $splash_message ]] || plymouth hide-message --text="$splash_message" 2>/dev/null || true
    splash_message=$*
    plymouth display-message --text="$*" 2>/dev/null || true
  else
    printf '%s\n' "$*"
  fi
}

fail() {
  printf 'Aurora setup: %s\n' "$*" > "$error_file" 2>/dev/null || true
  say "Aurora setup: $*"
  printf '\nAurora setup: %s\n' "$*" >&2
  exit 1
}

# Each mode desktop | text decides who creates the owner account.
choose_mode() {
  local target unit enabled directory
  text_requested && { echo text; return; }
  target=$(systemctl show --property=Id --value default.target 2>/dev/null || true)
  [[ $target == graphical.target ]] && systemctl cat display-manager.service >/dev/null 2>&1 || { echo text; return; }
  # The desktop's own setup only runs while the system has no owner.
  ! owner_exists || { echo text; return; }
  # A distribution that wires up the desktop's setup itself declares it.
  [[ ! -f /etc/aurora/desktop-account-setup ]] || { echo desktop; return; }
  for unit in plasma-setup.service; do
    enabled=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    if [[ $enabled == enabled && ! -e /etc/plasma-setup-done ]]; then echo desktop; return; fi
  done
  # GDM runs GNOME Initial Setup while the system has no owner.
  if [[ $(systemctl show --property=Id --value display-manager.service 2>/dev/null) == gdm.service ]]; then
    for directory in /usr/share /run/current-system/sw/share; do
      [[ ! -f $directory/gnome-session/sessions/gnome-initial-setup.session ]] || { echo desktop; return; }
    done
  fi
  echo text
}

prepare() {
  set -E
  trap 'printf "Aurora setup: a setup step failed (status %s): %s\n" "$?" "$BASH_COMMAND" | tee "$error_file" >&2' ERR
  trap 'unset password confirmation; stty echo 2>/dev/null || true' EXIT
  [[ -f /usr/lib/aurora/image-format && $(</usr/lib/aurora/image-format) == aurora-btrfs-v1 ]] ||
    fail 'This installation is not an Aurora image'
  local tool
  for tool in "$@" getent findmnt btrfs visudo cryptsetup python3 cut sync; do
    command -v "$tool" >/dev/null || fail "Required setup command is missing: $tool"
  done
  [[ ! -e /run/omarchy-mac-encrypt.failed ]] || fail "Root preparation failed: $(</run/omarchy-mac-encrypt.failed)"
  install -d -m 0700 "$state"
  label "$state"
  [[ $(findmnt -nro FSTYPE /) == btrfs ]] || fail 'This image requires a Btrfs root'
  btrfs filesystem resize max / >/dev/null
}

# Read data, never source instructions, from the durable encryption journal.
journal=$boot_dir/omarchy/encrypt.state
# The temporary key: one copy on the unencrypted boot filesystem, from which
# the initrd opens the disk without asking, and one inside the encrypted root.
boot_key=$boot_dir/omarchy/luks-key
# Written only when an interrupted conversion needed recovery. It holds the
# temporary key's keyslot, so with any surviving copy of that key it opens
# the disk even after the keyslot itself is gone.
header_backup=$boot_dir/omarchy/luks-header-before-recovery.bin
phase='' partition='' uuid='' device=''
read_journal() {
  local key value format=''
  [[ -f $journal && ! -L $journal ]] || fail 'Root preparation journal is missing'
  while IFS='=' read -r key value; do
    case $key in
      format) format=$value ;;
      phase) phase=$value ;;
      partition) partition=$value ;;
      luks_uuid) uuid=$value ;;
    esac
  done < "$journal"
  [[ $format == 1 ]] || fail 'Root preparation journal has an unsupported format'
  case $phase in
    declined) ;;
    configured|rekeyed|finished)
      [[ $partition =~ ^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$ &&
         $uuid =~ ^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$ ]] || fail 'Encrypted-root identity is invalid'
      device=/dev/disk/by-partuuid/$partition
      [[ $(cryptsetup luksUUID "$device") == "$uuid" ]] || fail 'Encrypted-root UUID differs from its journal'
      ;;
    *) fail "Root preparation is incomplete (phase=$phase)" ;;
  esac
}

# The disk still opens with the temporary key until the owner's password has
# replaced it.
disk_needs_password() {
  [[ $phase != declined ]] || return 1
  [[ $phase != finished || -e $state/luks-key || -e $boot_key ]]
}

# Overwrite, then unlink, every plain-file copy of the temporary key and the
# pre-recovery header backup. Once the temporary keyslot is gone a key copy no
# longer opens the disk by itself, but the header backup and a key copy
# together would. Overwriting is best effort (Btrfs copies on write and flash
# remaps blocks); removing the keyslot is what actually retires the key.
retire_key_files() {
  local file
  for file in "$state/luks-key" "$boot_key" "$header_backup"; do
    [[ -e $file || -L $file ]] || continue
    if [[ -f $file && ! -L $file ]] && command -v shred >/dev/null 2>&1; then
      shred --iterations=1 --zero --remove=wipesync -- "$file" 2>/dev/null || rm -f -- "$file"
    else
      rm -f -- "$file"
    fi
  done
  sync "$state" "$boot_dir/omarchy"
}

# The key slot a key file opens, from cryptsetup's verbose test; nothing
# when it opens none.
key_file_slot() {
  { cryptsetup open --test-passphrase --verbose --key-file "$1" "$device" 2>&1 || true; } |
    sed -n 's/^Key slot \([0-9][0-9]*\) unlocked\.$/\1/p' | head -n 1
}

# Enroll the password in key slot 1, prove it unlocks, then destroy the
# temporary keyslot and every copy of the temporary key. The disk never
# loses its last working slot: the temporary slot is removed only after the
# password has opened slot 1, and slot 1 is tested again afterwards. Every
# step can be resumed.
protect_disk() {
  local password=$1 keyfile=$state/luks-key slot
  if ! printf '%s' "$password" | cryptsetup open --test-passphrase --key-slot 1 --key-file=- "$device" 2>/dev/null; then
    [[ -f $keyfile && ! -L $keyfile ]] || fail 'The temporary encryption key is unavailable; use the original setup password to resume'
    # An occupied owner slot is never replaced implicitly.
    if cryptsetup luksDump --dump-json-metadata "$device" | python3 -c 'import json,sys; sys.exit(0 if "1" in json.load(sys.stdin)["keyslots"] else 1)'; then
      fail 'Enter the password already used for this installation to resume'
    fi
    say 'Protecting the encrypted disk with your password...'
    printf '%s' "$password" | cryptsetup luksAddKey --batch-mode --key-slot 1 --key-file "$keyfile" "$device" -
  fi
  printf '%s' "$password" | cryptsetup open --test-passphrase --key-slot 1 --key-file=- "$device" || fail 'The new password did not unlock the disk'
  for keyfile in "$state/luks-key" "$boot_key"; do
    [[ -f $keyfile && ! -L $keyfile ]] || continue
    slot=$(key_file_slot "$keyfile")
    [[ -n $slot ]] || continue
    # The password's own slot is never the one removed, and cryptsetup
    # removes the temporary slot only on the password's authority: it must
    # open another slot, so the disk can never be left without one.
    [[ $slot != 1 ]] || fail 'The temporary encryption key opens the password key slot'
    printf '%s' "$password" | cryptsetup luksKillSlot --batch-mode --key-file=- "$device" "$slot"
    [[ -z $(key_file_slot "$keyfile") ]] || fail 'The temporary encryption key is still usable'
  done
  printf '%s' "$password" | cryptsetup open --test-passphrase --key-slot 1 --key-file=- "$device" || fail 'Unlock failed after temporary-key removal'
  # The key files are retired only after the replacement unlock is proven.
  retire_key_files
  printf 'format=1\nphase=finished\npartition=%s\nluks_uuid=%s\n' "$partition" "$uuid" > "$journal.new"
  sync "$journal.new"
  mv "$journal.new" "$journal"
  label "$journal"
  sync "$boot_dir/omarchy"
  printf 'rekeyed\n' > "$state/disk-rekeyed"
  label "$state/disk-rekeyed"
  sync "$state/disk-rekeyed"
}

# Arch's sudoers does not enable the wheel group; the owner is created in it.
allow_wheel() {
  install -d -m 0755 /etc/sudoers.d
  printf '%%wheel ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/10-aurora-owner.new
  chmod 0440 /etc/sudoers.d/10-aurora-owner.new
  visudo -cf /etc/sudoers.d/10-aurora-owner.new >/dev/null
  mv -f /etc/sudoers.d/10-aurora-owner.new /etc/sudoers.d/10-aurora-owner
  label /etc/sudoers.d /etc/sudoers.d/10-aurora-owner
}

# BEGIN keyboard
# The disk password is typed at the initrd prompt with the console keymap,
# which every Aurora initrd copies from /etc/vconsole.conf when it is built,
# and at the greeter with the desktop's keyboard layout. When the two differ,
# the same keys give different characters, and the password the greeter
# hands over would not be what the person types at the next start.
vconsole_conf=${AURORA_VCONSOLE_CONF:-/etc/vconsole.conf}
x11_keyboard_conf=${AURORA_X11_KEYBOARD_CONF:-/etc/X11/xorg.conf.d/00-keyboard.conf}
# A distribution whose localed is read-only declares its layout here (NixOS).
declared_keyboard=${AURORA_DECLARED_KEYBOARD:-/etc/aurora/keyboard}
kbd_model_map=${AURORA_KBD_MODEL_MAP:-/usr/share/systemd/kbd-model-map}
initrd_dir=${AURORA_INITRD_DIR:-/boot}
run_dir=${AURORA_RUN_DIR:-/run}

# The last KEY=value of a shell-style file, unquoted, without sourcing it.
setting() {
  [[ -f $1 ]] || return 0
  sed -n "s/^[[:space:]]*$2=//p" "$1" | tail -n 1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}

# The desktop's keyboard layout and variant, as the greeter uses them: the
# first of each list. systemd 255 and later keep them in vconsole.conf;
# older ones and Xorg in 00-keyboard.conf.
kb_layout='' kb_variant=''
xorg_option() {
  [[ -f $x11_keyboard_conf ]] || return 0
  sed -n "s/^[[:space:]]*Option[[:space:]]*\"Xkb$1\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$x11_keyboard_conf" | tail -n 1
}
desktop_keyboard() {
  if [[ -f $declared_keyboard ]]; then
    kb_layout=$(setting "$declared_keyboard" layout)
    kb_variant=$(setting "$declared_keyboard" variant)
  elif [[ -n $(setting "$vconsole_conf" XKBLAYOUT) ]]; then
    kb_layout=$(setting "$vconsole_conf" XKBLAYOUT)
    kb_variant=$(setting "$vconsole_conf" XKBVARIANT)
  else
    kb_layout=$(xorg_option Layout)
    kb_variant=$(xorg_option Variant)
  fi
  kb_layout=${kb_layout%%,*}
  kb_variant=${kb_variant%%,*}
  [[ -n $kb_layout ]]
}

# The console keymap; the kernel's default is us.
console_keymap() {
  local keymap
  keymap=$(setting "$vconsole_conf" KEYMAP)
  printf '%s\n' "${keymap:-us}"
}

# Dead-key variants type the same printable characters as their layout.
plain_variant() {
  case $1 in -|*dead*) ;; *) printf '%s' "$1" ;; esac
}

# Does the console keymap $3 type what the XKB layout $1 (variant $2) types?
keymap_matches() {
  local layout=$1 variant keymap=$3
  variant=$(plain_variant "$2")
  # NixOS builds this keymap from its XKB settings (console.useXkbConfig).
  [[ $keymap != /*-xkb-console-keymap ]] || return 0
  if [[ -f $kbd_model_map ]] && awk -v keymap="$keymap" -v layout="$layout" -v variant="$variant" '
      function plain(v) { return (v == "-" || v ~ /dead/) ? "" : v }
      !/^#/ && $1 == keymap {
        split($2, l, ","); split($4, v, ",")
        if (l[1] == layout && plain(v[1]) == variant) found = 1
      }
      END { exit !found }' "$kbd_model_map"; then
    return 0
  fi
  # Keymaps converted from XKB, and most others, are named after the layout.
  [[ $keymap == "$layout" && -z $variant || $keymap == "$layout-$variant" ]] && return 0
  [[ -z $variant && ${keymap%%-*} == "$layout" ]]
}

# The console keymap closest to the desktop layout, as systemd-localed would
# choose it: a keymap converted from XKB if kbd ships one, else the
# kbd-model-map entry for the layout and variant.
converted_keymap() {
  local variant name directory file
  variant=$(plain_variant "$kb_variant")
  name=$kb_layout${variant:+-$variant}
  for directory in /usr/lib/kbd/keymaps/xkb /usr/share/kbd/keymaps/xkb; do
    for file in "$directory/$name".map*; do
      [[ -f $file ]] && { printf '%s\n' "$name"; return 0; }
    done
  done
  [[ -f $kbd_model_map ]] || return 1
  awk -v layout="$kb_layout" -v variant="$variant" '
    function plain(v) { return (v == "-" || v ~ /dead/) ? "" : v }
    !/^#/ { split($2, l, ","); split($4, v, ",")
      if (l[1] == layout && plain(v[1]) == variant) { print $1; found = 1; exit } }
    END { exit !found }' "$kbd_model_map"
}

# Before the password is enrolled: a console keymap still at the image
# default (unset or us) follows the layout the person chose for the desktop;
# a keymap set on purpose is left alone. Then any remaining difference is
# reported, since the password will be typed with that keymap at every start.
follow_desktop_keyboard() {
  local keymap converted
  if ! desktop_keyboard; then
    log 'the desktop keyboard layout is unknown; the disk password prompt uses the console keymap'
    return 0
  fi
  keymap=$(console_keymap)
  if ! keymap_matches "$kb_layout" "$kb_variant" "$keymap" && [[ $keymap == us && ! -e /etc/NIXOS ]] &&
     converted=$(converted_keymap) && command -v localectl >/dev/null 2>&1; then
    if localectl --no-convert set-keymap "$converted" 2>/dev/null; then
      log "the console keymap now follows the desktop layout ($kb_layout${kb_variant:+ $kb_variant}): $converted"
      keymap=$(console_keymap)
    fi
  fi
  keymap_matches "$kb_layout" "$kb_variant" "$keymap" && return 0
  warn "the desktop keyboard layout ($kb_layout${kb_variant:+ $kb_variant}) differs from the console keymap ($keymap) that the disk password prompt uses at every start; type the password there as on a $keymap keyboard, or set a matching keymap with localectl set-keymap"
}

# The keymap an initrd image was built with, from its copy of vconsole.conf
# (dracut's lsinitrd, mkinitcpio's lsinitcpio). An image without one uses the
# kernel's default keymap.
initrd_keymap() {
  local text='' extract
  if command -v lsinitrd >/dev/null 2>&1; then
    text=$(lsinitrd "$1" -f etc/vconsole.conf 2>/dev/null) || return 1
  elif command -v lsinitcpio >/dev/null 2>&1; then
    extract=$(mktemp -d) || return 1
    if (cd "$extract" && lsinitcpio -x "$1" etc/vconsole.conf) >/dev/null 2>&1; then
      text=$(cat -- "$extract/etc/vconsole.conf" 2>/dev/null || true)
    fi
    rm -rf -- "$extract"
  else
    return 1
  fi
  printf '%s\n' "$text" | sed -n 's/^[[:space:]]*KEYMAP=//p' | tail -n 1 | tr -d "\"'"
}

# aurora-initrd-keymap.service: rebuild the initrds when the console keymap
# they carry is not the system's, so the disk password prompt always uses
# the system keymap. NixOS builds its initrd from console.keyMap itself.
sync_initrd_keymap() {
  local wanted image current stale=0
  [[ ! -e /etc/NIXOS ]] || return 0
  [[ -f $journal ]] && ! grep -qx 'phase=declined' "$journal" || return 0
  exec 8> "$run_dir/aurora-initrd-keymap.lock"
  flock 8
  wanted=$(console_keymap)
  for image in "$initrd_dir"/initramfs-*.img; do
    [[ -f $image && $image != *rescue* && $image != *kdump* ]] || continue
    if ! current=$(initrd_keymap "$image"); then
      warn "cannot read the console keymap in $image"
      continue
    fi
    [[ ${current:-us} == "$wanted" ]] && continue
    log "$image has the console keymap ${current:-us}; the system uses $wanted"
    stale=1
  done
  (( stale )) || return 0
  if command -v dracut >/dev/null 2>&1; then
    dracut --regenerate-all --force && return 0
  elif command -v mkinitcpio >/dev/null 2>&1; then
    mkinitcpio -P && return 0
  fi
  warn "could not rebuild the initrd with the console keymap $wanted; the disk password prompt still uses the previous one"
  return 1
}
# END keyboard

# The owner's password reaches the disk through PAM, when the owner first
# signs in with it at the greeter. Desktop setups sign the new owner in
# without a password (Plasma Setup's one-time automatic login), so while the
# disk still opens with its temporary key, a gate fails the owner's
# automatic login and the greeter asks for the password instead. GNOME
# Initial Setup signs the owner in with the password it just set. Each hook
# is one line, first in its stack, removed again once the disk is rekeyed.
pam_dir=${AURORA_PAM_DIR:-/etc/pam.d}
pam_vendor_dir=${AURORA_PAM_VENDOR_DIR:-/usr/lib/pam.d}
password_hook=${AURORA_PASSWORD_HOOK:-/usr/lib/aurora/aurora-password-hook}
rekey_dir=${AURORA_REKEY_DIR:-/run/aurora-firstboot}
declared_hooks=${AURORA_DECLARED_HOOKS:-/etc/aurora/password-hooks}
# Written once the owner's password unlocks the disk and the temporary key is
# gone (protect_disk); the PAM hooks do nothing from then on.
disk_rekeyed() { [[ -e $state/disk-rekeyed ]]; }
hook_marker='# aurora-firstboot: the owner password also becomes the disk password'
override_marker='# aurora-firstboot: a temporary copy of the vendor configuration'

# PAM service, stack and hook line.
hook_services() {
  printf '%s\n' \
    "plasmalogin auth optional pam_exec.so quiet expose_authtok $password_hook" \
    "sddm auth optional pam_exec.so quiet expose_authtok $password_hook" \
    "gdm-password auth optional pam_exec.so quiet expose_authtok $password_hook" \
    "plasmalogin-autologin auth requisite pam_exec.so quiet $password_hook --gate" \
    "sddm-autologin auth requisite pam_exec.so quiet $password_hook --gate"
}

# The file PAM reads for a service: /etc/pam.d, else the vendor directory.
# Generated read-only configurations (NixOS) are never edited.
hook_source() {
  local service=$1
  if [[ -e $pam_dir/$service || -L $pam_dir/$service ]]; then
    [[ -f $pam_dir/$service && ! -L $pam_dir/$service && -w $pam_dir/$service ]] || return 1
    printf '%s\n' "$pam_dir/$service"
  elif [[ -f $pam_vendor_dir/$service && -w $pam_dir ]]; then
    printf '%s\n' "$pam_vendor_dir/$service"
  else
    return 1
  fi
}

# A desktop whose owner password can be followed: the distribution declares
# permanent hooks, or a greeter's PAM file can carry one.
password_hooks_available() {
  local service rest
  [[ ! -f $declared_hooks ]] || return 0
  while read -r service rest; do
    case $service in plasmalogin | sddm | gdm-password) hook_source "$service" >/dev/null && return 0 ;; esac
  done < <(hook_services)
  return 1
}

# Insert the marker and hook line before the first rule.
add_hook() {
  awk -v marker="$hook_marker" -v line="$2" '
    !done && /^[[:space:]]*[^#[:space:]]/ { print marker; print line; done = 1 }
    { print }
    END { if (!done) { print marker; print line } }' "$1"
}

arm_password_hooks() {
  local service rest source target armed=1
  [[ ! -f $declared_hooks ]] || return 0
  while read -r service rest; do
    source=$(hook_source "$service") || continue
    target=$pam_dir/$service
    if [[ $service != *autologin ]]; then armed=0; fi
    ! grep -qxF "$hook_marker" "$source" || continue
    if [[ $source != "$target" ]]; then
      { printf '%s\n' "$override_marker"; add_hook "$source" "$rest"; } > "$target.aurora-new"
      chmod 0644 "$target.aurora-new"
    else
      add_hook "$target" "$rest" > "$target.aurora-new"
      chmod "$(stat -c %a "$target")" "$target.aurora-new"
    fi
    mv -f "$target.aurora-new" "$target"
    label "$target"
  done < <(hook_services)
  return $armed
}

disarm_password_hooks() {
  local service rest target
  while read -r service rest; do
    target=$pam_dir/$service
    [[ -f $target && ! -L $target ]] && grep -qxF "$hook_marker" "$target" || continue
    if [[ $(head -n 1 "$target") == "$override_marker" ]]; then
      rm -f -- "$target"
      continue
    fi
    awk -v marker="$hook_marker" -v hook="$password_hook" '
      $0 == marker { pending = 1; next }
      pending && index($0, hook) { pending = 0; next }
      { pending = 0; print }' "$target" > "$target.aurora-new"
    chmod "$(stat -c %a "$target")" "$target.aurora-new"
    mv -f "$target.aurora-new" "$target"
    label "$target"
  done < <(hook_services)
}

# A person's account by name: a regular UID and a login shell.
is_owner() {
  getent passwd "$1" | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { found = 1 } END { exit !found }'
}

# While the disk still opens with its temporary key, the owner signs in with
# a password: the gate fails the owner's automatic login.
rekey_pending() { ! disk_rekeyed && [[ -f $state/desktop && ! -f $state/pending && -f $state/luks-key ]]; }

# Called by pam_exec. With --gate it only decides an automatic login.
# Otherwise it reads the password from stdin, checks it and hands it to
# aurora-disk-rekey.service, which rekeys in the background; it never delays
# or fails the sign-in.
password_hook() {
  local user=${PAM_USER:-} type=${PAM_TYPE:-} password='' checker candidate
  # Once the disk is rekeyed the hooks do nothing, also where they stay
  # declared until the next rebuild (NixOS).
  ! disk_rekeyed || return 0
  if [[ ${1:-} == --gate ]]; then
    ! { rekey_pending && is_owner "$user"; } || return 1
    return 0
  fi
  rekey_pending || return 0
  [[ $type == auth || $type == password ]] && is_owner "$user" || return 0
  IFS= read -r -d '' password || [[ -n $password ]] || return 0
  [[ -n $password ]] || return 0
  if [[ $type == auth ]]; then
    # A sign-in attempt: only the owner's actual password counts.
    checker=''
    for candidate in ${AURORA_UNIX_CHKPWD:-} "$(command -v unix_chkpwd || true)" /usr/sbin/unix_chkpwd \
      /usr/bin/unix_chkpwd /run/wrappers/bin/unix_chkpwd; do
      [[ -x $candidate ]] && { checker=$candidate; break; }
    done
    [[ -n $checker ]] || return 0
    printf '%s\0' "$password" | "$checker" "$user" nonull || return 0
  fi
  install -d -m 0700 "$rekey_dir"
  printf '%s' "$password" > "$rekey_dir/password.new"
  unset password
  mv -f "$rekey_dir/password.new" "$rekey_dir/password"
  log "rekeying the disk with the password of $user ($type)"
  systemctl start --no-block aurora-disk-rekey.service
}

# NixOS declares the hooks in its generated PAM configuration. Once they have
# done their job, the machine configuration switches them off, so the next
# rebuild drops them; until then the marker keeps them inert. Only the
# factory owner.nix is rewritten; an edited one gets a note instead.
nixos_owner=${AURORA_NIXOS_OWNER:-/etc/nixos/owner.nix}
nixos_hooks_off='aurora.firstboot.passwordHooks = false;'
retire_declared_hooks() {
  [[ -f $declared_hooks ]] || return 0
  [[ -f $nixos_owner && ! -L $nixos_owner ]] || return 0
  ! grep -qF "$nixos_hooks_off" "$nixos_owner" || return 0
  if [[ $(<"$nixos_owner") == '{ ... }: {}' ]]; then
    printf '%s\n' '# Aurora image machine configuration' '{ ... }: {' \
      '  # The account password unlocks the disk; the first-boot PAM hooks are done.' \
      "  $nixos_hooks_off" '}' > "$nixos_owner.new"
    chmod 0644 "$nixos_owner.new"
    sync "$nixos_owner.new"
    mv -f "$nixos_owner.new" "$nixos_owner"
    log "the next rebuild removes the first-boot PAM hooks ($nixos_owner)"
  else
    log "add $nixos_hooks_off to $nixos_owner to remove the first-boot PAM hooks at the next rebuild"
  fi
}

# aurora-disk-rekey.service: enroll the owner's password, retire the
# temporary key, then remove the PAM hooks.
rekey_from_owner_password() {
  local password=''
  exec 9> /run/aurora-disk-rekey.lock
  flock 9
  [[ -f $rekey_dir/password && ! -L $rekey_dir/password ]] || return 0
  password=$(<"$rekey_dir/password")
  rm -f -- "$rekey_dir/password"
  read_journal
  if disk_needs_password; then
    follow_desktop_keyboard
    protect_disk "$password"
    log 'the owner password now unlocks the disk; the temporary key is gone'
  fi
  unset password
  disarm_password_hooks
  retire_declared_hooks
  # Rebuilding an initrd takes a while; it runs on its own, and again
  # whenever vconsole.conf changes (aurora-initrd-keymap.path).
  [[ -e /etc/NIXOS ]] || systemctl start --no-block aurora-initrd-keymap.service 2>/dev/null || true
}

# Ask twice for the disk password: on the splash when it is up, otherwise on
# the console. The person at the first boot is the owner.
ask_disk_password() {
  local confirmation
  while :; do
    if splash_up; then
      say 'Choose a password for this Mac'"'"'s disk. You will enter it whenever the Mac starts.'
      password=$(plymouth ask-for-password --prompt='New disk password') || fail 'The disk password prompt was closed'
      confirmation=$(plymouth ask-for-password --prompt='Retype the disk password') || fail 'The disk password prompt was closed'
    else
      printf '\nChoose a password for this Mac'"'"'s disk. You will enter it whenever the Mac starts.\n'
      read -r -s -p 'Disk password: ' password
      printf '\n'
      read -r -s -p 'Retype disk password: ' confirmation
      printf '\n'
    fi
    [[ -z $password || $password != "$confirmation" ]] || break
    say 'The passwords did not match or were empty. Try again.'
  done
  unset confirmation
}

# Desktop images: the desktop's own setup creates the owner account. In
# account mode its password becomes the disk password later, through PAM;
# otherwise the disk password is asked for now, on the splash.
setup_desktop() {
  local password='' follow=${1:-}
  prepare
  read_journal
  if disk_needs_password; then
    if [[ $follow == account ]]; then
      arm_password_hooks || fail 'The desktop sign-in cannot set the disk password'
    else
      ask_disk_password
      protect_disk "$password"
      unset password
    fi
  fi
  allow_wheel
  # The disk password was chosen on its own; the text wizard, if it is ever
  # used for recovery, does not tie the account password to it.
  printf 'desktop\n' > "$state/desktop"
  label "$state/desktop"
  sync "$state/desktop"
  rm -- "$state/pending"
  sync "$state"
  [[ $follow == account ]] || say 'Starting setup...'
}

setup_text() {
  prepare useradd usermod chpasswd
  local username='' hostname='' owner=()
  if [[ -e $state/owner ]]; then
    [[ -f $state/owner && ! -L $state/owner ]] || fail 'Owner journal is invalid'
    mapfile -t owner < "$state/owner"
    (( ${#owner[@]} == 2 )) || fail 'Owner journal is incomplete'
    username=${owner[0]}
    hostname=${owner[1]}
  fi
  printf '\nWelcome to Aurora\n\nCreate your Linux account. Your macOS account stays separate.\n'
  if [[ -z $username ]]; then
    while :; do
      read -r -p 'Linux username: ' username
      if [[ ! $username =~ ^[a-z][a-z0-9_-]{0,30}$ ]]; then
        printf 'Use a lowercase username, starting with a letter.\n'
      elif getent passwd "$username" >/dev/null; then
        printf 'That username already exists.\n'
      else
        break
      fi
    done
    while :; do
      read -r -p 'Computer name [aurora]: ' hostname
      hostname=${hostname:-aurora}
      [[ ! $hostname =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || break
      printf 'Use a computer name containing letters, numbers and hyphens.\n'
    done
    printf '%s\n%s\n' "$username" "$hostname" > "$state/owner.new"
    sync "$state/owner.new"
    mv "$state/owner.new" "$state/owner"
    label "$state/owner"
    sync "$state"
  else
    [[ $username =~ ^[a-z][a-z0-9_-]{0,30}$ && $hostname =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || fail 'Owner journal fields are invalid'
    printf 'Resuming setup for %s on %s.\n' "$username" "$hostname"
  fi
  local password confirmation
  while :; do
    read -r -s -p 'Linux password (also unlocks an encrypted root): ' password
    printf '\n'
    read -r -s -p 'Retype password: ' confirmation
    printf '\n'
    [[ -z $password || $password != "$confirmation" ]] || break
    printf 'The passwords do not match or are empty. Try again.\n'
  done
  unset confirmation

  # The disk is rekeyed before the account password is set, so a resumed
  # setup can never leave the account and the disk with different passwords.
  # After a desktop setup protected the disk, the account password is free.
  read_journal
  if [[ ! -e $state/desktop && $phase != declined ]]; then
    protect_disk "$password"
  fi

  # A resumed setup reuses an account an interrupted run already created.
  if ! id "$username" >/dev/null 2>&1; then
    local shell=/bin/bash
    [[ ! -x /run/current-system/sw/bin/bash ]] || shell=/run/current-system/sw/bin/bash
    useradd --create-home --shell "$shell" "$username"
  fi
  local uid
  uid=$(id -u "$username")
  (( uid >= 1000 && uid < 60000 )) || fail 'Owner account has an unexpected user ID'
  usermod --append --groups wheel "$username"
  printf '%s:%s\n' "$username" "$password" | chpasswd
  unset password
  label -R "/home/$username" /etc/passwd /etc/shadow /etc/group
  [[ ! -e /etc/gshadow ]] || label /etc/gshadow
  # Replace NixOS's generated /etc symlink atomically without writing into its store.
  printf '%s\n' "$hostname" > /etc/hostname.aurora-new
  chmod 0644 /etc/hostname.aurora-new
  mv -Tf /etc/hostname.aurora-new /etc/hostname
  label /etc/hostname
  printf '%s\n' "$hostname" > /proc/sys/kernel/hostname
  allow_wheel

  if [[ -e /etc/NIXOS ]]; then
    [[ -f /etc/nixos/owner.nix ]] || fail 'The installed NixOS machine configuration is missing'
    getent shadow "$username" | cut -d: -f2 > /var/lib/aurora/owner-password.hash
    chmod 0600 /var/lib/aurora/owner-password.hash
    # Once the password unlocks the disk the first-boot PAM hooks are done.
    local hooks=''
    ! disk_rekeyed || hooks="
  $nixos_hooks_off"
    cat > /etc/nixos/owner.nix.new <<EOF
# Aurora image machine configuration
{ ... }: {
  networking.hostName = "$hostname";$hooks
  users.users."$username" = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    hashedPasswordFile = "/var/lib/aurora/owner-password.hash";
  };
}
EOF
    mv /etc/nixos/owner.nix.new /etc/nixos/owner.nix
    sync /etc/nixos /var/lib/aurora/owner-password.hash
  fi
  printf '%s\n' "$username" > "$state/complete"
  label "$state/complete"
  local account_files=(/etc/passwd /etc/shadow /etc/group)
  [[ ! -e /etc/gshadow ]] || account_files+=(/etc/gshadow)
  sync "$state/complete" "${account_files[@]}"
  rm -- "$state/pending"
  sync "$state"
  printf '\nAurora setup is complete. Sign in as %s.\n' "$username"
}

# Each attempt runs as its own process: errexit stays in force there, and a
# failed attempt cannot leave secrets or half-set state in this one.
if [[ ${1:-} == --attempt ]]; then
  rm -f -- "$error_file"
  case ${2:-text} in
    account) setup_desktop account ;;
    desktop) setup_desktop ;;
    *) setup_text ;;
  esac
  exit 0
fi
case ${1:-} in
  --password-hook) password_hook "${@:2}" || exit 1; exit 0 ;;
  --rekey) rekey_from_owner_password; exit 0 ;;
  --sync-initrd-keymap) sync_initrd_keymap; exit $? ;;
esac

mode=$(choose_mode)
# The account password the desktop's setup sets also unlocks the disk, so
# nothing is asked on the splash.
[[ $mode != desktop ]] || ! password_hooks_available || mode=account
log "first-boot mode: $mode"
quiet_console
trap restore_console EXIT
# On the MacBook Neo the boot splash stops updating once the installed
# system has started, so nothing is ever asked on it: the text wizard and a
# desktop that must ask for a disk password use the console.
if [[ $mode == text || $mode == desktop ]]; then
  release_splash
  show_text_console
fi
# Every step is resumable from the owner and encryption journals, so a failed
# attempt is retried in place instead of failing the boot behind the greeter.
until "$BASH" "${BASH_SOURCE[0]}" --attempt "$mode"; do
  if splash_up; then
    # The splash would hide the failure; continue on the console.
    release_splash
    show_text_console
    [[ ! -s $error_file ]] || cat -- "$error_file" >&2
  fi
  printf '\nSetup did not finish. Fix the problem above if you can, then press Enter to try again.\n'
  printf 'Your progress is kept; restarting the computer also resumes setup.\n'
  read -r _ || exit 1
done
restore_console
"$(dirname -- "${BASH_SOURCE[0]}")/aurora-firstboot-handoff"
