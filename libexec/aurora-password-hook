#!/bin/bash
# SPDX-License-Identifier: MIT
# pam_exec entry point: the owner's password, when the owner first signs in
# with it, also becomes the disk password (see aurora-firstboot). SELinux
# runs this file, and only this file, from the greeters in the unconfined
# service domain that rekeys the disk.
exec /usr/lib/aurora/aurora-firstboot --password-hook "$@"
