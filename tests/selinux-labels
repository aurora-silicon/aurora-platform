#!/bin/bash
# SPDX-License-Identifier: MIT
# Real Fedora policy/xattr fixture; no host paths are relabelled.
set -euo pipefail
source_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT
mkdir -p "$fixture/etc/aurora" "$fixture/usr/lib/aurora" "$fixture/var/lib/aurora/firstboot" "$fixture/boot/efi" "$fixture/etc/systemd" "$fixture/etc/selinux/targeted/contexts/files"
cp -a /etc/selinux/targeted/contexts/files/. "$fixture/etc/selinux/targeted/contexts/files/"
touch "$fixture/etc/aurora/image-layout" "$fixture/usr/lib/aurora/image-format" "$fixture/var/lib/aurora/firstboot/pending"
# A regular file in the excluded ESP must remain untouched.
touch "$fixture/boot/efi/ESP-fixture"
before=$(stat -c %C "$fixture/boot/efi/ESP-fixture" 2>/dev/null || true)
bash "$source_root/images/label-fedora-rootfs" "$fixture"
[[ $(stat -c %C "$fixture/boot/efi/ESP-fixture" 2>/dev/null || true) == "$before" ]]
# The gate must reject absent policy before accepting an exported filesystem.
rm "$fixture/etc/selinux/targeted/contexts/files/file_contexts"
if bash "$source_root/images/label-fedora-rootfs" "$fixture"; then
  echo 'Missing targeted policy was accepted' >&2
  exit 1
fi
printf 'Offline Fedora labels verified with SELinux kernel state: '
getenforce
